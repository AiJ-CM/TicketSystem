@host = http://localhost:5218

### 用户注册 (Register)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "zhangsan",
  "password": "!!123abc",
  "email": "zhangsan@example.com"
}

### 用户登录 (Login)
# @name login

POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "zhangsan",
  "password": "!!123abc"
}

### 用户信息 (GetProfile)
# @name login

GET {{host}}/api/auth/profile
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.token}}

### 创建工单 (CreateTicket)
POST {{host}}/api/Tickets
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.token}}

{
  "title": "打印机无法连接",
  "description": "办公区3号打印机无法连接网络",
  "ticketType": "IT_SUPPORT",
  "priority": 1
}

### 获取单个工单 (GetTicket)
GET {{host}}/api/Tickets/1
Accept: application/json
Authorization: Bearer {{login.response.body.$.token}}